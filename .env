# Google sign-in (Firebase project rps10-b5833). These values are public by design: Firebase puts them
# in every web page that signs people in. Kept in .env (not .env.local) so the GitHub Pages build gets them too.
VITE_FIREBASE_API_KEY=AIzaSyBHhLDLHpeV3mQdUBCIYAbIVNb8Xmm3TV0
VITE_FIREBASE_AUTH_DOMAIN=rps10-b5833.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rps10-b5833
VITE_FIREBASE_APP_ID=1:100715519061:web:73234fc828e806ddf608dc

# The game's full public address, ending in "/", e.g. https://<username>.github.io/<repository>/
# Used for link previews (the image chat apps show). Empty still builds; some apps then skip the image.
VITE_SITE_URL=https://ekamjunks-cloud.github.io/RPS/
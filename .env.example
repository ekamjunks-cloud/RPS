# Optional. Copy to .env.local to point the game at a different Spacetime server or database.
# Defaults (used when this file is absent): Maincloud and the rps-10-b7hi9 database.
VITE_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=rps-10-b7hi9

# Google sign-in. Firebase console → Project settings → Your apps → Web app → "firebaseConfig".
# Leave empty to run guest-only. Also put the project ID in spacetimedb/src/config.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
